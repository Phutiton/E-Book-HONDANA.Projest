    function exportCurrentReportToCSV() {
      if (!currentReportData || !currentReportData.data) {
        alert('ไม่มีข้อมูลสำหรับส่งออก');
        return;
      }

      let csvContent = '\uFEFF';
      const rows = currentReportData.data;

      if (currentReportId === 1) {
        csvContent += "ประจำเดือน,จำนวนคำสั่งซื้อ,ยอดขายรวม(บาท),ยอดเฉลี่ยต่อออเดอร์(บาท)\n";
        rows.forEach(r => {
          csvContent += `"${r.month}","${r.total_orders}","${r.total_revenue}","${r.avg_order_value}"\n`;
        });
      } else if (currentReportId === 2) {
        csvContent += "อันดับ,ชื่อเรื่อง,หมวดหมู่,ผู้แต่ง,ยอดขาย(เล่ม),ยอดขายรวม(บาท)\n";
        rows.forEach((r, idx) => {
          csvContent += `"${idx + 1}","${r.title}","${r.category_name}","${r.author_name}","${r.total_units_sold}","${r.total_revenue}"\n`;
        });
      } else if (currentReportId === 3) {
        csvContent += "รหัสหมวด,ชื่อหมวดหมู่,ชื่อหนังสือย่อย,ยอดขายหนังสือ(เล่ม),ยอดขายรวมหมวด(บาท),ออเดอร์ที่ถูกปฏิเสธ\n";
        rows.forEach(r => {
          (r.sub_books || []).forEach(b => {
            csvContent += `"${r.category_id}","${r.category_name}","${b.title}","${b.units_sold}","${r.total_category_revenue}","${r.rejected_orders_count}"\n`;
          });
        });
      } else if (currentReportId === 4) {
        csvContent += "ชื่อลูกค้า,อีเมล,ออเดอร์ทั้งหมด,ออเดอร์สำเร็จ,ออเดอร์ปฏิเสธ,ยอดซื้อสะสม(บาท)\n";
        rows.forEach(r => {
          csvContent += `"${r.full_name}","${r.email}","${r.total_orders}","${r.confirmed_orders}","${r.cancelled_orders}","${r.confirmed_spending}"\n`;
        });
      }

      const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `hondana_report_${currentReportId}_${new Date().toISOString().slice(0,10)}.csv`);
