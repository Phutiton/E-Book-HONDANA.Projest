<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hondana 本棚 - Manga & Light Novel Hub</title>  
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Modern Clean Typography: Cinzel (Brand), Inter & Noto Sans Thai (Clean UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;800;900&family=Inter:wght@400;500;600;700&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            paper: {
              main: '#0d0d0f',
              card: '#16161a',
              cardHover: '#1f1f24',
              border: '#26262b',
              borderDark: '#36363d',
              dark: '#212126'
            },
            ink: {
              primary: '#f4f4f6',
              secondary: '#c5c5cd',
              muted: '#8b8b96',
              light: '#5e5e68'
            },
            leather: {
              DEFAULT: '#e11d48',
              hover: '#be123c',
              light: '#ffe4e6'
            },
            tea: {
              DEFAULT: '#10b981',
              hover: '#059669',
              light: '#d1fae5'
            }
          },
          fontFamily: {
            sans: ['"Inter"', '"Noto Sans Thai"', 'sans-serif'],
            brand: ['"Cinzel"', 'serif']
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #0d0d0f;
      color: #f4f4f6;
      font-family: 'Inter', 'Noto Sans Thai', sans-serif;
      letter-spacing: -0.01em;
    }
    .vintage-card {
      background-color: #16161a;
      border: 1px solid #26262b;
      box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.45);
      transition: all 0.2s ease;
    }
    .vintage-card:hover {
      border-color: #e11d48;
      box-shadow: 0 0 20px -2px rgba(225, 29, 72, 0.5), 0 0 8px rgba(225, 29, 72, 0.3);
      transform: translateY(-4px);
    }
    .neon-glow-red {
      box-shadow: 0 0 18px -2px rgba(225, 29, 72, 0.6), 0 0 6px rgba(225, 29, 72, 0.4);
    }
    ::-webkit-scrollbar { width: 7px; height: 7px; }
    ::-webkit-scrollbar-track { background: #0d0d0f; }
    ::-webkit-scrollbar-thumb { background: #26262b; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #e11d48; }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-leather selection:text-white">

  <!-- ========================================================================= -->
  <!-- 1. TOP NAVIGATION                                                         -->
  <!-- ========================================================================= -->
  <header class="sticky top-0 z-40 bg-[#0d0d0f]/90 backdrop-blur-xl border-b border-paper-border/80 px-4 lg:px-8 py-3 transition-all">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3 cursor-pointer group flex-shrink-0" onclick="switchTab('catalog')">
        <div class="relative w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-zinc-950 flex items-center justify-center text-white border border-rose-500/40 shadow-[0_0_15px_rgba(244,63,94,0.35)] transform group-hover:scale-105 transition-all duration-300">
          <span class="text-lg font-black tracking-tighter">本</span>
          <div class="absolute -top-1 -right-1 w-2 h-2 bg-rose-400 rounded-full animate-ping"></div>
          <div class="absolute -top-1 -right-1 w-2 h-2 bg-rose-500 rounded-full border border-black"></div>
        </div>
        
        <div>
          <div class="flex items-center gap-1.5">
            <h1 class="font-extrabold text-xl tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-white via-zinc-100 to-rose-300 font-brand">
              HONDANA
            </h1>
            <span class="text-[10px] px-1.5 py-0.2 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20 font-bold">本棚</span>
          </div>
          <p class="text-[9px] text-zinc-400 tracking-[0.2em] font-medium -mt-0.5 uppercase">
            Manga & Novel Hub
          </p>
        </div>
      </div>

      <!-- Main Navigation Tabs -->
      <nav class="flex items-center gap-1 bg-[#141418] p-1 rounded-xl border border-paper-border text-xs font-medium overflow-x-auto max-w-full">
        <button id="nav-catalog" onclick="switchTab('catalog')" class="px-3 py-1.5 rounded-lg transition-all text-white bg-gradient-to-r from-rose-600 to-rose-700 shadow-sm font-medium">
          หน้าร้าน
        </button>
        <button id="nav-cart" onclick="requireLogin(()=>switchTab('cart'))" class="px-3 py-1.5 rounded-lg transition-all text-zinc-400 hover:text-white relative">
          ตะกร้า
          <span id="cart-badge" class="hidden ml-1 px-1.5 py-0.5 bg-rose-600 text-white text-[10px] rounded-full font-bold">0</span>
        </button>
        <button id="nav-orders" onclick="requireLogin(()=>switchTab('orders'))" class="px-3 py-1.5 rounded-lg transition-all text-zinc-400 hover:text-white">
          คำสั่งซื้อ
        </button>
        <button id="nav-profile" onclick="requireLogin(()=>switchTab('profile'))" class="px-3 py-1.5 rounded-lg transition-all text-zinc-400 hover:text-white">
          โปรไฟล์
        </button>
        <button id="nav-admin" onclick="switchTab('admin')" class="hidden px-3 py-1.5 rounded-lg transition-all text-zinc-400 hover:text-white">
          หลังบ้าน
        </button>
        <button id="nav-reports" onclick="switchTab('reports')" class="hidden px-3 py-1.5 rounded-lg transition-all text-zinc-400 hover:text-white">
          รายงานสถิติ
        </button>
      </nav>

      <!-- Right User Controls -->
      <div class="flex items-center gap-2.5 flex-shrink-0">
        <div id="user-display" class="flex items-center gap-2"></div>
        <button id="btn-open-login" onclick="openLoginModal()" class="px-3.5 py-1.5 text-xs bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 text-white rounded-xl font-medium transition-all shadow-md">
          เข้าสู่ระบบ
        </button>
        <button id="btn-logout" onclick="handleLogout()" class="hidden px-3 py-1.5 text-xs bg-zinc-900/90 hover:bg-rose-950/60 hover:text-rose-300 text-zinc-400 border border-paper-border hover:border-rose-500/40 rounded-xl transition-all font-medium">
          ออกจากระบบ
        </button>
      </div>

    </div>
  </header>

  <!-- Global Toast Alert -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-16 opacity-0 transition-all duration-300 pointer-events-none">
    <div id="toast-body" class="bg-paper-card text-ink-primary px-4 py-2.5 rounded-xl shadow-2xl text-xs flex items-center gap-2 border border-paper-border">
      <span id="toast-icon"></span>
      <span id="toast-text">ข้อความแจ้งเตือน</span>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- 2. MAIN VIEW CONTAINER                                                    -->
  <!-- ========================================================================= -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 lg:p-8">

    <!-- TAB 1: E-BOOK CATALOG -->
    <section id="tab-catalog" class="space-y-6">
      <div class="relative overflow-hidden rounded-2xl border border-rose-500/20 bg-gradient-to-r from-zinc-950 via-[#131118] to-rose-950/30 p-6 lg:p-8 shadow-xl">
        <div class="absolute -right-6 -bottom-10 text-[9rem] font-black text-white/[0.03] select-none pointer-events-none font-serif">
          本棚
        </div>
        <div class="absolute -top-16 right-20 w-44 h-44 bg-rose-600/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-xl space-y-2.5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/10 text-rose-400 text-[11px] font-medium border border-rose-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            MANGA & LIGHT NOVEL DIGITAL HUB
          </div>
          <h2 class="text-xl lg:text-3xl font-extrabold text-white tracking-tight">
            เปิดโลกจินตนาการ <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-amber-300">อ่านได้ทันที</span>
          </h2>
          <p class="text-xs text-zinc-400 leading-relaxed max-w-md">
            คลังมังงะและไลท์โนเวลแปลไทยถูกลิขสิทธิ์ สั่งซื้อง่าย ตรวจสอบสิทธิ์ปลอดภัย พร้อมอ่านฉบับดิจิทัลคมชัดสูง
          </p>
        </div>
      </div>

      <div class="flex flex-col md:flex-row items-center justify-between gap-3 bg-gradient-to-r from-[#141418] via-[#16161c] to-[#141418] p-3 rounded-2xl border border-rose-500/20 shadow-md">
        <div class="relative w-full md:w-96">
          <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-rose-400/70">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </span>
          <input 
            type="text" 
            id="search-input" 
            placeholder="ค้นหาชื่อเรื่อง, นักเขียน, คำอธิบาย..." 
            class="w-full pl-9 pr-4 py-2 bg-[#0d0d0f] border border-paper-border rounded-xl text-xs text-zinc-100 placeholder-zinc-500 focus:outline-none focus:border-rose-500/70 focus:ring-1 focus:ring-rose-500/30 transition-all font-normal"
            oninput="handleSearch()"
          />
        </div>

        <div class="flex items-center gap-2.5 w-full md:w-auto">
          <span class="text-xs text-zinc-400 whitespace-nowrap font-medium">หมวดหมู่:</span>
          <select 
            id="category-filter" 
            class="w-full md:w-64 px-3 py-2 bg-[#0d0d0f] border border-paper-border rounded-xl text-xs text-zinc-200 focus:outline-none focus:border-rose-500/70 focus:ring-1 focus:ring-rose-500/30 font-normal cursor-pointer"
            onchange="handleFilterCategory()"
          >
            <option value="">ทั้งหมด (All Categories)</option>
          </select>
        </div>
      </div>

      <div id="ebooks-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5"></div>
    </section>

    <!-- TAB 2: SHOPPING CART & CHECKOUT -->
    <section id="tab-cart" class="hidden space-y-6">
      <div class="flex items-center justify-between border-b border-paper-border/80 pb-4">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-xl font-bold text-white tracking-tight">ตะกร้าสินค้า</h2>
            <span class="px-2 py-0.5 rounded-full bg-rose-500/10 text-rose-400 text-[11px] font-semibold border border-rose-500/20">CHECKOUT</span>
          </div>
          <p class="text-xs text-zinc-400 mt-0.5">ตรวจสอบรายการและชำระเงินผ่าน PromptPay เพื่อรออนุมัติสิทธิ์การดาวน์โหลด</p>
        </div>
        <button onclick="switchTab('catalog')" class="text-xs font-medium text-rose-400 hover:text-amber-300 transition-colors flex items-center gap-1 group">
          <span class="transform group-hover:-translate-x-1 transition-transform">←</span> เลือกดูมังงะเรื่องอื่น
        </button>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-3">
          <div id="cart-items-container" class="space-y-3"></div>
        </div>

        <div class="vintage-card p-6 rounded-2xl border border-rose-500/20 h-fit space-y-5 bg-gradient-to-b from-[#16161c] to-[#121216] shadow-xl">
          <h3 class="text-sm font-bold text-white flex items-center justify-between border-b border-paper-border/80 pb-3">
            <span>สรุปคำสั่งซื้อ</span>
          </h3>
          
          <div class="space-y-2.5 text-xs text-zinc-300">
            <div class="flex justify-between">
              <span class="text-zinc-400">จำนวนรวม:</span>
              <span id="summary-items-count" class="font-medium text-white">0 เล่ม</span>
            </div>
            <div class="flex justify-between items-baseline pt-2 border-t border-paper-border/80">
              <span class="font-medium text-zinc-200">ยอดชำระสุทธิ:</span>
              <span id="summary-total-price" class="text-xl font-black text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-amber-300">฿0.00</span>
            </div>
          </div>

          <div class="bg-[#0e0e12] p-4 rounded-2xl border border-paper-border space-y-3.5 text-xs">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="font-medium text-zinc-200">PromptPay QR</span>
              </div>
              <span class="text-[10px] text-zinc-400">สแกนจ่ายได้ทุกธนาคาร</span>
            </div>
            
            <div class="relative w-36 h-36 mx-auto bg-white p-2.5 rounded-2xl shadow-[0_0_20px_rgba(244,63,94,0.15)] flex items-center justify-center">
              <img id="qr-mock-img" src="https://api.qrserver.com/v1/create-qr-code/?size=130x130&data=PROMPTPAY_HONDANA_ORDER" alt="QR Code" class="w-full h-full object-contain">
            </div>

            <div class="space-y-2 pt-1">
              <label class="block text-[11px] font-medium text-zinc-300">แนบสลิปการโอนเงิน:</label>
              
              <div class="relative border border-dashed border-zinc-700 hover:border-rose-500/60 rounded-xl p-3 bg-zinc-950/40 text-center transition-all cursor-pointer">
                <input 
                  type="file" 
                  id="checkout-slip-file" 
                  accept="image/*"
                  onchange="handleSlipFileSelect(event)"
                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
                />
                <div class="text-[11px] text-zinc-400 flex flex-col items-center gap-1">
                  <span class="text-rose-400 font-semibold">เลือกไฟล์สลิปโอนเงิน</span>
                  <span class="text-[9px] text-zinc-500">รองรับไฟล์ JPG, PNG</span>
                </div>
              </div>

              <input type="hidden" id="checkout-slip-data">
              
              <div id="checkout-slip-preview-box" class="hidden mt-2 p-2.5 bg-[#16161c] rounded-xl border border-emerald-500/30 flex items-center gap-3">
                <img id="checkout-slip-preview" src="" class="w-9 h-12 object-cover rounded-lg border border-emerald-500/40">
                <div class="text-left leading-tight">
                  <div class="text-xs font-semibold text-emerald-300">แนบสลิปเรียบร้อย</div>
                  <div class="text-[10px] text-zinc-400">พร้อมสำหรับการตรวจสอบ</div>
                </div>
              </div>
            </div>
          </div>

          <button 
            onclick="handleCheckout()" 
            id="btn-checkout"
            class="w-full py-3 bg-gradient-to-r from-rose-600 via-rose-500 to-amber-500 hover:opacity-95 text-white rounded-xl font-bold text-xs transition-all shadow-[0_4px_16px_rgba(244,63,94,0.3)] flex items-center justify-center gap-2 active:scale-98"
          >
            แจ้งชำระเงินและส่งตรวจสอบสลิป
          </button>
        </div>
      </div>
    </section>

    <!-- TAB 3: MY ORDERS -->
    <section id="tab-orders" class="hidden space-y-6">
      <div class="border-b border-paper-border pb-4">
        <h2 class="text-lg font-semibold text-ink-primary">คำสั่งซื้อและการดาวน์โหลด</h2>
        <p class="text-xs text-ink-muted">ติดตามผลการตรวจสลิป และดาวน์โหลดไฟล์เมื่อแอดมินยืนยันแล้ว</p>
      </div>

      <div class="p-3.5 rounded-2xl bg-gradient-to-r from-[#16141a] via-[#1a151e] to-[#16141a] border border-rose-500/20 text-xs text-zinc-300 flex items-start gap-3 shadow-md">
        <div class="w-7 h-7 rounded-xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 flex-shrink-0 text-sm font-semibold">
          i
        </div>
        <div class="leading-relaxed">
          <span class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-amber-300">ระบบกำลังดำเนินการ:</span> 
          ลิงก์ดาวน์โหลดไฟล์ E-Book จะถูกส่งให้โดยอัตโนมัติเมื่อคำสั่งซื้อได้รับการ
          <span class="px-2 py-0.5 bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 rounded-full text-[10px] font-semibold">อนุมัติแล้ว (Confirmed)</span> 
        </div>
      </div>

      <div id="orders-list-container" class="space-y-3.5"></div>
    </section>

    <!-- TAB 4: USER PROFILE -->
    <section id="tab-profile" class="hidden space-y-6">
      <div class="relative overflow-hidden rounded-2xl border border-rose-500/20 bg-gradient-to-r from-zinc-950 via-[#131118] to-rose-950/30 p-5 shadow-xl flex items-center justify-between">
        <div class="absolute -right-4 -bottom-6 text-[7rem] font-black text-white/[0.03] select-none pointer-events-none font-serif">
          本棚
        </div>
        
        <div class="relative z-10 space-y-1">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-rose-500/10 text-rose-400 text-[10px] font-bold border border-rose-500/20 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
            ACCOUNT SETTINGS
          </div>
          <h2 class="text-lg lg:text-xl font-extrabold text-white tracking-tight font-brand">
            จัดการโปรไฟล์ผู้ใช้
          </h2>
        </div>

        <div class="relative z-10 hidden sm:block text-right">
          <div class="text-[10px] text-zinc-400 font-mono">HONDANA</div>
          <div class="text-xs font-bold text-rose-400">MANGA & NOVEL</div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-5">
          <div class="vintage-card rounded-2xl border border-paper-border bg-[#16161a] shadow-xl overflow-hidden relative">
            <div class="h-20 bg-gradient-to-r from-zinc-950 via-[#1c1622] to-zinc-950 relative border-b border-paper-border px-5 flex items-center justify-between"></div>

            <div class="px-6 relative pb-4 border-b border-paper-border bg-[#16161a]">
              <div class="flex items-end justify-between gap-4 -mt-8 mb-1">
                <div class="flex items-end gap-4">
                  <div class="relative group cursor-pointer z-20 flex-shrink-0" onclick="document.getElementById('prof-avatar-file').click()" title="เปลี่ยนรูปโปรไฟล์">
                    <div class="w-20 h-20 rounded-xl bg-zinc-900 border-2 border-rose-500/60 shadow-lg overflow-hidden group-hover:border-rose-500 transition-all">
                      <div id="prof-avatar-box" class="w-full h-full bg-[#0d0d0f] flex items-center justify-center text-xl font-black text-rose-400">
                        <span id="prof-avatar-letter">U</span>
                      </div>
                    </div>
                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center text-white text-[10px] font-medium transition-opacity rounded-xl">
                      เปลี่ยนรูป
                    </div>
                  </div>

                  <div class="mb-1 space-y-1">
                    <h3 id="prof-display-name" class="text-sm font-bold text-white tracking-tight">กำลังโหลดชื่อ...</h3>
                    <div class="flex items-center gap-2">
                      <span id="prof-role-badge" class="px-2 py-0.5 bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[9px] font-bold rounded uppercase tracking-wider">
                        MEMBER
                      </span>
                      <span class="text-[10px] text-zinc-500">• สมาชิก</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <input type="file" id="prof-avatar-file" accept="image/*" onchange="handleAvatarFileSelect(event)" class="hidden">
            <input type="hidden" id="prof-avatar-data">

            <div class="p-6 space-y-4 text-xs">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label class="block text-zinc-300 font-medium">ชื่อ - นามสกุล</label>
                  <input type="text" id="prof-fullname" class="w-full px-3.5 py-2.5 bg-[#0d0d0f] border border-paper-border rounded-xl text-zinc-100 focus:outline-none focus:border-rose-500/70 transition-all">
                </div>
                <div class="space-y-1.5">
                  <label class="block text-zinc-300 font-medium">เบอร์โทรศัพท์</label>
                  <input type="text" id="prof-phone" class="w-full px-3.5 py-2.5 bg-[#0d0d0f] border border-paper-border rounded-xl text-zinc-100 focus:outline-none focus:border-rose-500/70 transition-all">
                </div>
              </div>

              <div class="space-y-1.5">
                <label class="block text-zinc-400 font-medium">อีเมลบัญชีผู้ใช้ (PDPA Protected)</label>
                <input type="text" id="prof-email" disabled class="w-full px-3.5 py-2.5 bg-[#0a0a0d] border border-paper-border rounded-xl text-zinc-500 font-mono text-xs cursor-not-allowed">
              </div>

              <div class="p-4 bg-[#0e0e12] rounded-xl border border-paper-border space-y-3">
                <div class="flex items-center justify-between border-b border-paper-border pb-2">
                  <h4 class="text-zinc-200 font-bold text-xs">เปลี่ยนรหัสผ่าน</h4>
                  <span class="text-[10px] text-zinc-500 font-mono">OPTIONAL</span>
                </div>

