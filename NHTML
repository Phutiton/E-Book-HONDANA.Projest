      const preview = document.getElementById('edit-book-preview');
      const previewText = document.getElementById('preview-text');
      if (book.cover_image_url) {
        preview.src = book.cover_image_url;
        preview.classList.remove('hidden');
        previewText.classList.add('hidden');
      } else {
        preview.classList.add('hidden');
        previewText.classList.remove('hidden');
      }

      document.getElementById('edit-book-modal').classList.remove('hidden');
      document.getElementById('edit-book-modal').classList.add('flex');
    }

    function closeEditBookModal() {
      document.getElementById('edit-book-modal').classList.add('hidden');
      document.getElementById('edit-book-modal').classList.remove('flex');
    }

    async function handleSaveEditBook() {
      const id = document.getElementById('edit-book-id').value;
      const title = document.getElementById('edit-book-title').value.trim();
      const price = parseFloat(document.getElementById('edit-book-price').value);
      const cover_image_url = document.getElementById('edit-book-img').value.trim();
      const description = document.getElementById('edit-book-desc').value.trim();

      const res = await fetch(`/api/ebooks/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'X-User-Id': currentUser.user_id },
        body: JSON.stringify({ title, price, cover_image_url, description })
      });
      const data = await res.json();
      if (data.success) {
        showToast('บันทึกข้อมูลสำเร็จ');
        closeEditBookModal();
        await loadEbooks();
        loadAdminBooks();
      }
    }
  </script>

</body>
</html>
