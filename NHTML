    function switchTab(tabId) {
      const adminOnlyTabs = ['admin', 'reports'];
      const loginRequiredTabs = ['cart', 'orders', 'profile', 'admin', 'reports'];

      if (adminOnlyTabs.includes(tabId)) {
        if (!currentUser) {
          openLoginModal();
          showToast('กรุณาเข้าสู่ระบบก่อน');
          return;
        }
        if (currentUser.role_id !== 1) {
          showToast('เฉพาะผู้ดูแลระบบ (Admin) เท่านั้น');
          switchTab('catalog');
          return;
        }
      }

      if (loginRequiredTabs.includes(tabId) && !currentUser) {
        openLoginModal();
        showToast('กรุณาเข้าสู่ระบบก่อน');
        return;
      }

      currentTab = tabId;
      const tabs = ['catalog', 'cart', 'orders', 'profile', 'admin', 'reports'];
      tabs.forEach(t => {
        document.getElementById(`tab-${t}`).classList.add('hidden');
        const navBtn = document.getElementById(`nav-${t}`);
        if (navBtn) {
          const isAdminOnlyTab = adminOnlyTabs.includes(t);
          const isAdminUser = currentUser && currentUser.role_id === 1;
          if (isAdminOnlyTab && !isAdminUser) {
            navBtn.className = 'hidden px-3.5 py-1.5 rounded-lg transition-all text-ink-muted hover:text-ink-primary';
          } else {
            navBtn.className = 'px-3.5 py-1.5 rounded-lg transition-all text-ink-muted hover:text-ink-primary';
          }
        }
      });

      document.getElementById(`tab-${tabId}`).classList.remove('hidden');
      const activeNav = document.getElementById(`nav-${tabId}`);
      if (activeNav) {
        activeNav.className = 'px-3.5 py-1.5 rounded-lg transition-all text-white bg-leather shadow-sm font-medium';
      }

      if (tabId === 'cart') loadCart();
      if (tabId === 'orders') loadMyOrders();
      if (tabId === 'admin') loadAdminOrders();
      if (tabId === 'reports') loadReport(1);
    }

