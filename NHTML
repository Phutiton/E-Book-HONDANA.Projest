  <!-- 4. JAVASCRIPT FRONTEND LOGIC                                              -->
  <!-- ========================================================================= -->
  <script>
    let currentUser = null;
    let allCategories = [];
    let allAuthors = [];
    let allEbooks = [];
    let currentTab = 'catalog';
    let currentReportData = null;
    let currentReportId = 1;

    document.addEventListener('DOMContentLoaded', async () => {
      const savedUser = localStorage.getItem('ebook_vintage_user');
      if (savedUser) {
        try { currentUser = JSON.parse(savedUser); } catch(e) {}
      }
      updateUserUI();
      await loadCategories();
      await loadAuthors();
      await loadEbooks();
      if (currentUser) await updateCartBadge();
    });

    function showToast(message, icon = '') {
      const toast = document.getElementById('toast');
      const text = document.getElementById('toast-text');
      const ic = document.getElementById('toast-icon');
      text.innerText = message;
      ic.innerText = icon;
      toast.classList.remove('translate-y-16', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-16', 'opacity-0');
      }, 3000);
    }

    function updateUserUI() {
      const display = document.getElementById('user-display');
      const btnLogin = document.getElementById('btn-open-login');
      const btnLogout = document.getElementById('btn-logout');
      const navAdmin = document.getElementById('nav-admin');
      const navReports = document.getElementById('nav-reports');

      if (currentUser) {
       const avatarImgTag = currentUser.avatar_url 
          ? `<img src="${currentUser.avatar_url}" class="w-6 h-6 rounded-lg object-cover">`
          : `<div class="w-6 h-6 rounded-lg bg-gradient-to-br from-rose-500 to-amber-400 flex items-center justify-center text-[11px] font-black text-black shadow-inner">${currentUser.full_name ? currentUser.full_name.charAt(0) : 'U'}</div>`;

        display.innerHTML = `
          <div class="flex items-center gap-2 px-2.5 py-1 rounded-xl bg-[#141418] border border-rose-500/20 shadow-sm">
            ${avatarImgTag}
            <div class="text-left leading-none hidden sm:block">
              <div class="text-xs font-semibold text-zinc-100">${currentUser.full_name}</div>
              <div class="text-[9px] text-amber-300/80 font-mono tracking-wider uppercase mt-0.5">${currentUser.role_id === 1 ? 'Admin' : 'Member'}</div>
            </div>
          </div>
        `;
        btnLogin.classList.add('hidden');
        btnLogout.classList.remove('hidden');

        if (currentUser.role_id === 1) {
          navAdmin.classList.remove('hidden');
          navReports.classList.remove('hidden');
        } else {
          navAdmin.classList.add('hidden');
          navReports.classList.add('hidden');
        }

       const profEmail = document.getElementById('prof-email');
        const profFullname = document.getElementById('prof-fullname');
        const profPhone = document.getElementById('prof-phone');
        const profRoleBadge = document.getElementById('prof-role-badge');
        const profAvatarBox = document.getElementById('prof-avatar-box');
        const profDisplayName = document.getElementById('prof-display-name');
        
        if (profEmail) profEmail.value = currentUser.email || '';
        if (profFullname) profFullname.value = currentUser.full_name || '';
        if (profPhone) profPhone.value = currentUser.phone || '';
        if (profDisplayName) profDisplayName.innerText = currentUser.full_name || 'สมาชิก HONDANA';

        if (profAvatarBox) {
          const rawName = currentUser.full_name ? currentUser.full_name.trim() : 'U';
          const firstChar = rawName.charAt(0);
          
          if (currentUser.avatar_url) {
            profAvatarBox.innerHTML = `<img src="${currentUser.avatar_url}" class="w-full h-full object-cover rounded-[14px]">`;
          } else {
            profAvatarBox.innerHTML = `
              <div class="w-full h-full bg-[#111115] rounded-[14px] flex items-center justify-center text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-rose-400 to-amber-300 font-sans">
                <span>${firstChar}</span>
              </div>
            `;
          }
        }
      } else {
        display.innerHTML = `<span class="text-xs text-ink-muted">ยังไม่ได้เข้าสู่ระบบ</span>`;
        btnLogin.classList.remove('hidden');
        btnLogout.classList.add('hidden');
        navAdmin.classList.add('hidden');
        navReports.classList.add('hidden');
      }
    }

    function requireLogin(callback) {
      if (!currentUser) {
        openLoginModal();
        return;
      }
      callback();
    }
    function openBookDetailModal(ebookId) {
      const book = allEbooks.find(b => b.ebook_id === ebookId);
      if (!book) return;

      const randomRating = (4.0 + ((book.ebook_id * 7) % 10) * 0.1).toFixed(1);
      const defaultCover = book.cover_image_url || 'https://images.unsplash.com/photo-1607604276583-eef5d076aa5f?auto=format&fit=crop&w=600&q=80';

      // จำลองชุดภาพตัวอย่างหลายรูปสำหรับประกอบการตัดสินใจ (รวมภาพหลักและภาพสไตล์ใกล้เคียงกัน)
      const previewImages = [
        defaultCover,
      ];

      document.getElementById('detail-cover').src = defaultCover;
      document.getElementById('detail-category').innerText = book.category_name ? book.category_name.split('(')[0].trim() : 'ทั่วไป';
      document.getElementById('detail-title').innerText = book.title;
      document.getElementById('detail-author').innerText = `ผู้แต่ง: ${book.author_name || 'ไม่ระบุ'}`;
      document.getElementById('detail-rating').innerText = `★ ${randomRating}`;
      document.getElementById('detail-desc').innerText = book.description || 'ยังไม่มีคำอธิบายสำหรับหนังสือเล่มนี้';
      document.getElementById('detail-price').innerText = `฿${Number(book.price).toFixed(2)}`;

      

      const addBtn = document.getElementById('detail-add-btn');
      if (book.is_active) {
        addBtn.disabled = false;
        addBtn.className = 'px-6 py-3 bg-gradient-to-r from-rose-600 via-rose-500 to-amber-500 hover:opacity-95 text-white rounded-xl text-xs font-bold shadow-[0_4px_20px_rgba(244,63,94,0.4)] transition-all active:scale-95 flex items-center gap-2';
        addBtn.setAttribute('onclick', `handleAddToCart(${book.ebook_id}); closeBookDetailModal();`);
        addBtn.innerText = 'ใส่ตะกร้าสินค้า';
      } else {
        addBtn.disabled = true;
        addBtn.className = 'px-6 py-3 bg-zinc-800 text-zinc-500 rounded-xl text-xs font-bold cursor-not-allowed';
        addBtn.innerText = 'ปิดการขายชั่วคราว';
      }

      const modal = document.getElementById('book-detail-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    function closeBookDetailModal() {
      const modal = document.getElementById('book-detail-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    function openLoginModal() {
      document.getElementById('login-error').classList.add('hidden');
      document.getElementById('login-email').value = '';
      document.getElementById('login-password').value = '';
      document.getElementById('register-modal').classList.add('hidden');
      document.getElementById('login-modal').classList.remove('hidden');
      document.getElementById('login-modal').classList.add('flex');
    }

    function closeLoginModal() {
      document.getElementById('login-modal').classList.add('hidden');
      document.getElementById('login-modal').classList.remove('flex');
    }

    async function handleLogin() {
      const email = document.getElementById('login-email').value.trim().toLowerCase();
      const password = document.getElementById('login-password').value.trim();
      const errBox = document.getElementById('login-error');

      if (!email || !password) {
        errBox.textContent = 'กรุณากรอกอีเมลและรหัสผ่าน';
        errBox.classList.remove('hidden');
        return;
      }

      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });
      const data = await res.json();

      if (data.success) {
        currentUser = data.user;
        localStorage.setItem('ebook_vintage_user', JSON.stringify(currentUser));
        closeLoginModal();
        updateUserUI();
        await updateCartBadge();
        showToast(`ยินดีต้อนรับ ${currentUser.full_name}`);
        if (currentTab === 'orders') loadMyOrders();
        if (currentTab === 'cart') loadCart();
      } else {
        errBox.textContent = data.error || 'อีเมลหรือรหัสผ่านไม่ถูกต้อง';
        errBox.classList.remove('hidden');
      }
    }

    function handleLogout() {
      currentUser = null;
      localStorage.removeItem('ebook_vintage_user');
      updateUserUI();
      if (['cart', 'orders', 'profile', 'admin', 'reports'].includes(currentTab)) {
        switchTab('catalog');
      }
      document.getElementById('cart-badge').classList.add('hidden');
      showToast('ออกจากระบบเรียบร้อยแล้ว');
    }

    function openRegisterModal() {
      document.getElementById('reg-error').classList.add('hidden');
      document.getElementById('reg-fullname').value = '';
      document.getElementById('reg-email').value = '';
      document.getElementById('reg-phone').value = '';
      document.getElementById('reg-password').value = '';
      document.getElementById('reg-pdpa').checked = false;
      document.getElementById('login-modal').classList.add('hidden');
      document.getElementById('register-modal').classList.remove('hidden');
      document.getElementById('register-modal').classList.add('flex');
    }

    function closeRegisterModal() {
      document.getElementById('register-modal').classList.add('hidden');
      document.getElementById('register-modal').classList.remove('flex');
    }

    function openPdpaModal() {
      document.getElementById('pdpa-modal').classList.remove('hidden');
      document.getElementById('pdpa-modal').classList.add('flex');
    }

    function closePdpaModal() {
      document.getElementById('pdpa-modal').classList.add('hidden');
      document.getElementById('pdpa-modal').classList.remove('flex');
    }

    function acceptPdpaAndClose() {
      document.getElementById('reg-pdpa').checked = true;
      closePdpaModal();
    }

    async function handleRegister() {
      const full_name = document.getElementById('reg-fullname').value.trim();
      const email = document.getElementById('reg-email').value.trim().toLowerCase();
      const phone = document.getElementById('reg-phone').value.trim();
      const password = document.getElementById('reg-password').value.trim();
      const pdpa_consent = document.getElementById('reg-pdpa').checked;
      const errBox = document.getElementById('reg-error');

      errBox.classList.add('hidden');

      if (!pdpa_consent) {
        errBox.textContent = 'กรุณากดยอมรับเงื่อนไขนโยบาย PDPA ก่อนสมัครสมาชิก';
        errBox.classList.remove('hidden');
        return;
      }

      if (!full_name || !email || !password) {
        errBox.textContent = 'กรุณากรอกชื่อ-นามสกุล อีเมล และรหัสผ่านให้ครบ';
        errBox.classList.remove('hidden');
        return;
      }

      const res = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ full_name, email, phone, password, pdpa_consent })
      });
      const data = await res.json();

      if (data.success) {
        currentUser = data.user;
